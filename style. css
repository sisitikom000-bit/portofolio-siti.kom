* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg: #050512;
    --bg-soft: #09091c;
    --purple: #9d7cff;
    --pink: #e879f9;
    --blue: #67e8f9;
    --text: #f5f3ff;
    --muted: #9997b5;
    --border: rgba(157, 124, 255, 0.18);
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--bg);
    color: var(--text);
    font-family: "Inter", sans-serif;
    overflow-x: hidden;
    line-height: 1.7;
}


/* =========================
   STAR FIELD
========================= */

.stars,
.stars::after {
    position: fixed;
    inset: 0;
    pointer-events: none;
}

.stars {
    z-index: -5;

    background-image:
        radial-gradient(1px 1px at 10% 20%, white, transparent),
        radial-gradient(1px 1px at 25% 70%, white, transparent),
        radial-gradient(1px 1px at 40% 30%, white, transparent),
        radial-gradient(1px 1px at 60% 80%, white, transparent),
        radial-gradient(1px 1px at 80% 20%, white, transparent),
        radial-gradient(1px 1px at 90% 60%, white, transparent),
        radial-gradient(1px 1px at 50% 50%, white, transparent),
        radial-gradient(1px 1px at 15% 90%, white, transparent);

    background-size: 250px 250px;

    opacity: .5;

    animation: starsMove 80s linear infinite;
}

.stars-2 {
    opacity: .25;
    transform: scale(1.4);
    animation-duration: 120s;
}

.stars-3 {
    opacity: .15;
    transform: scale(1.8);
    animation-duration: 160s;
}

@keyframes starsMove {

    from {
        transform: translateY(0);
    }

    to {
        transform: translateY(-500px);
    }

}


/* =========================
   NAVBAR
========================= */

.navbar {
    position: fixed;
    top: 0;
    left: 50%;
    transform: translateX(-50%);

    width: min(1150px, 92%);

    padding: 20px 0;

    display: flex;
    justify-content: space-between;
    align-items: center;

    z-index: 100;

    backdrop-filter: blur(12px);
}

.logo {
    font-family: "Orbitron", sans-serif;
    font-size: 20px;
    letter-spacing: 2px;
}

.logo span {
    color: var(--purple);
}

.nav-links {
    display: flex;
    gap: 35px;
}

.nav-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
    transition: .3s;
}

.nav-links a:hover {
    color: var(--text);
}

.nav-button {
    padding: 9px 18px;

    border: 1px solid var(--border);
    border-radius: 30px;

    color: var(--text);
    text-decoration: none;

    font-size: 13px;

    transition: .3s;
}

.nav-button:hover {
    border-color: var(--purple);
    box-shadow: 0 0 20px rgba(157,124,255,.25);
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 100vh;

    width: min(1150px, 92%);

    margin: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 50px;

    padding-top: 80px;
}

.hero-content {
    max-width: 650px;
}

.small-title {
    color: var(--purple);
    font-family: "Orbitron", sans-serif;
    font-size: 12px;
    letter-spacing: 3px;

    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(45px, 7vw, 80px);
    line-height: 1.05;
    letter-spacing: -4px;
}

.hero h1 span {
    display: block;

    background: linear-gradient(
        90deg,
        var(--purple),
        var(--pink),
        var(--blue)
    );

    -webkit-background-clip: text;
    color: transparent;
}

.hero h2 {
    margin-top: 20px;

    font-size: 25px;

    font-weight: 400;

    color: var(--muted);
}

.hero h2 span {
    color: var(--blue);
}

.hero p {
    margin-top: 20px;

    color: var(--muted);

    max-width: 570px;
}

.hero-buttons {
    display: flex;
    gap: 15px;

    margin-top: 35px;
}

.button {
    display: inline-flex;
    align-items: center;
    gap: 12px;

    padding: 13px 22px;

    border-radius: 30px;

    text-decoration: none;

    font-size: 14px;

    transition: .3s;
}

.primary {
    background: linear-gradient(
        100deg,
        var(--purple),
        var(--pink)
    );

    color: white;

    box-shadow:
        0 0 30px rgba(157,124,255,.25);
}

.primary:hover {
    transform: translateY(-3px);
    box-shadow:
        0 10px 40px rgba(157,124,255,.35);
}

.secondary {
    color: var(--text);

    border: 1px solid var(--border);
}

.secondary:hover {
    border-color: var(--purple);
}

.code-line {
    margin-top: 50px;

    font-family: monospace;

    font-size: 13px;

    color: #666482;
}

.code-line span {
    color: var(--pink);
}

.code-line b {
    color: var(--blue);
}


/* =========================
   GALAXY
========================= */

.galaxy {
    width: 430px;
    height: 430px;

    position: relative;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;
}

.planet {
    width: 155px;
    height: 155px;

    border-radius: 50%;

    position: relative;

    background:
        radial-gradient(
            circle at 35% 30%,
            #e9d5ff,
            #9d7cff 30%,
            #5226a7 65%,
            #140c32
        );

    box-shadow:
        0 0 40px rgba(157,124,255,.5),
        0 0 100px rgba(157,124,255,.2);
}

.planet-light {
    position: absolute;

    width: 35px;
    height: 35px;

    background: rgba(255,255,255,.15);

    border-radius: 50%;

    top: 25px;
    left: 35px;

    filter: blur(5px);
}

.orbit {
    position: absolute;

    border: 1px solid rgba(157,124,255,.25);

    border-radius: 50%;

    transform: rotate(-20deg);
}

.orbit-one {
    width: 300px;
    height: 120px;
}

.orbit-two {
    width: 390px;
    height: 170px;

    transform: rotate(25deg);
}

.orbit-three {
    width: 430px;
    height: 220px;

    transform: rotate(-45deg);
}

.satellite {
    position: absolute;

    width: 12px;
    height: 12px;

    border-radius: 50%;

    background: var(--blue);

    box-shadow:
        0 0 20px var(--blue);

    top: 95px;
    right: 40px;
}


/* =========================
   SECTION
========================= */

.section {
    width: min(1100px, 92%);

    margin: auto;

    padding: 130px 0;
}

.section-heading span {
    font-family: "Orbitron", sans-serif;

    color: var(--purple);

    font-size: 11px;

    letter-spacing: 3px;
}

.section-heading h2 {
    margin-top: 12px;

    font-size: clamp(35px, 5vw, 55px);

    line-height: 1.15;

    max-width: 700px;
}

.section-heading em {
    font-style: normal;

    color: var(--muted);
}


/* =========================
   ABOUT
========================= */

.about-grid {
    margin-top: 60px;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 60px;
}

.about-text p {
    color: var(--muted);

    margin-bottom: 20px;
}


/* TERMINAL */

.terminal {
    background: #070712;

    border: 1px solid var(--border);

    border-radius: 15px;

    overflow: hidden;

    box-shadow:
        0 20px 80px rgba(0,0,0,.4);
}

.terminal-header {
    height: 42px;

    display: flex;
    align-items: center;

    gap: 20px;

    padding: 0 15px;

    border-bottom: 1px solid var(--border);

    color: #77758e;

    font-family: monospace;

    font-size: 12px;
}

.terminal-dots {
    display: flex;
    gap: 6px;
}

.terminal-dots i {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: #444;
}

.terminal-body {
    padding: 25px;

    font-family: monospace;

    font-size: 13px;

    color: #aaa8bd;
}

.terminal-body p {
    margin-bottom: 12px;
}

.green {
    color: #86efac;
}

.output {
    color: var(--blue);

    padding-left: 10px;
}


/* =========================
   SKILLS
========================= */

.skills-grid {
    margin-top: 60px;

    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 20px;
}

.skill-card {
    position: relative;

    padding: 35px;

    background:
        linear-gradient(
            145deg,
            rgba(157,124,255,.08),
            rgba(255,255,255,.02)
        );

    border: 1px solid var(--border);

    border-radius: 18px;

    transition: .4s;

    overflow: hidden;
}

.skill-card::after {
    content: "";

    position: absolute;

    width: 120px;
    height: 120px;

    border-radius: 50%;

    background: var(--purple);

    filter: blur(80px);

    opacity: .08;

    right: -30px;
    bottom: -30px;
}

.skill-card:hover {
    transform: translateY(-7px);

    border-color: rgba(157,124,255,.5);

    box-shadow:
        0 20px 60px rgba(0,0,0,.3);
}

.skill-number {
    position: absolute;

    right: 25px;
    top: 20px;

    font-family: "Orbitron", sans-serif;

    font-size: 11px;

    color: #55536e;
}

.skill-icon {
    font-size: 30px;

    color: var(--purple);

    font-family: monospace;

    margin-bottom: 20px;
}

.skill-card h3 {
    font-size: 20px;
}

.skill-card p {
    color: var(--muted);

    margin: 10px 0 20px;
}

.tags {
    display: flex;
    flex-wrap: wrap;

    gap: 8px;
}

.tags span {
    padding: 5px 10px;

    border-radius: 20px;

    background: rgba(157,124,255,.08);

    color: var(--purple);

    font-size: 11px;
}


/* =========================
   PROJECTS
========================= */

.projects-grid {
    margin-top: 60px;

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 20px;
}

.project-card {
    background: #080817;

    border: 1px solid var(--border);

    border-radius: 18px;

    overflow: hidden;

    transition: .4s;
}

.project-card:hover {
    transform: translateY(-7px);

    border-color: rgba(157,124,255,.5);
}

.project-image {
    height: 210px;

    display: flex;

    align-items: center;

    justify-content: center;

    position: relative;

    overflow: hidden;
}

.project-web {
    background:
        radial-gradient(
            circle at 50% 50%,
            #4c1d95,
            #10071e 65%
        );
}

.project-app {
    background:
        radial-gradient(
            circle,
            #164e63,
            #07111c 70%
        );
}

.project-game {
    background:
        radial-gradient(
            circle,
            #831843,
            #100712 70%
        );
}

.browser {
    width: 75%;

    border: 1px solid rgba(255,255,255,.2);

    border-radius: 8px;

    overflow: hidden;

    background: rgba(0,0,0,.3);

    backdrop-filter: blur(10px);
}

.browser-top {
    height: 25px;

    border-bottom: 1px solid rgba(255,255,255,.1);

    display: flex;

    align-items: center;

    padding-left: 10px;

    gap: 5px;
}

.browser-top span {
    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: #aaa;
}

.browser-content {
    height: 100px;

    display: flex;

    align-items: center;

    justify-content: center;

    font-family: monospace;

    color: var(--blue);
}

.app-symbol,
.game-symbol {
    font-size: 60px;

    color: white;

    text-shadow:
        0 0 30px var(--purple);
}

.project-info {
    padding: 25px;
}

.project-type {
    color: var(--purple);

    font-family: "Orbitron", sans-serif;

    font-size: 9px;

    letter-spacing: 2px;
}

.project-info h3 {
    margin: 8px 0;

    font-size: 20px;
}

.project-info p {
    color: var(--muted);

    font-size: 13px;
}

.project-info a {
    display: inline-block;

    margin-top: 15px;

    color: var(--blue);

    text-decoration: none;

    font-size: 13px;
}


/* =========================
   CONTACT
========================= */

.contact {
    width: min(850px, 92%);

    margin: 80px auto 150px;

    padding: 100px 30px;

    text-align: center;

    position: relative;

    border: 1px solid var(--border);

    border-radius: 30px;

    overflow: hidden;

    background:
        radial-gradient(
            circle at center,
            rgba(157,124,255,.12),
            transparent 65%
        );
}

.contact-orbit {
    position: absolute;

    width: 500px;
    height: 150px;

    border: 1px solid rgba(157,124,255,.15);

    border-radius: 50%;

    left: 50%;
    top: 50%;

    transform: translate(-50%, -50%) rotate(-15deg);
}

.contact > span {
    position: relative;

    font-family: "Orbitron", sans-serif;

    font-size: 10px;

    letter-spacing: 3px;

    color: var(--purple);
}

.contact h2 {
    position: relative;

    margin: 20px auto;

    font-size: clamp(35px, 5vw, 55px);

    line-height: 1.1;

    max-width: 700px;
}

.contact h2 em {
    display: block;

    font-style: normal;

    color: var(--muted);
}

.contact p {
    position: relative;

    color: var(--muted);

    max-width: 550px;

    margin: auto auto 30px;
}

.contact .button {
    position: relative;
}


/* =========================
   FOOTER
========================= */

footer {
    padding: 50px 20px;

    text-align: center;

    border-top: 1px solid var(--border);

    color: #5f5d77;

    font-size: 12px;
}

.footer-logo {
    font-family: "Orbitron", sans-serif;

    color: var(--text);

    margin-bottom: 10px;
}

.footer-logo span {
    color: var(--purple);
}

.footer-code {
    margin-top: 10px;

    color: var(--purple);

    font-family: monospace;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 800px) {

    .navbar {
        width: 90%;
    }

    .nav-links {
        display: none;
    }

    .hero {
        flex-direction: column;

        text-align: center;

        padding-top: 150px;
    }

    .hero p {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-buttons {
        justify-content: center;
    }

    .code-line {
        text-align: left;
    }

    .galaxy {
        width: 300px;
        height: 300px;

        transform: scale(.8);
    }

    .about-grid,
    .skills-grid,
    .projects-grid {
        grid-template-columns: 1fr;
    }

    .section {
        padding: 90px 0;
    }

}
